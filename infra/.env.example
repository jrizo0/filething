# filething — local infra environment (TEMPLATE — do not copy this by hand).
#
#   infra/scripts/up.sh  copies this file to infra/.env AND replaces every
#   REPLACE_ME below with a freshly generated random value.
#
# Every REPLACE_ME is a credential that used to ship as a working default
# (minioadmin/minioadmin, a 64-zero instance secret). That made every stack that
# booted "out of the box" ownable by anyone who could reach the port, and this
# compose has been run on a public VPS. up.sh now REFUSES to start while any
# REPLACE_ME is still in infra/.env.

# ---------------------------------------------------------------------------
# Vault — MinIO (S3-compatible data plane)
# ---------------------------------------------------------------------------
# MinIO root credentials (used by the server and by the bucket-init script).
MINIO_ROOT_USER=REPLACE_ME
MINIO_ROOT_PASSWORD=REPLACE_ME

# S3 endpoint the Rust ft-vault crate (S3 backend) points at.
# Path-style addressing; switch to R2 by changing only these values.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Same credential pair as MINIO_ROOT_USER/PASSWORD above (MinIO's root account IS
# the S3 key pair) — up.sh fills all four with the same generated values.
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
# The single Vault bucket holding blocks/, manifest/, blocklist/.
S3_BUCKET=filething

# Host ports (container ports are fixed: 9000 API, 9001 console).
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Address the published ports bind to. 127.0.0.1 keeps MinIO, the Convex backend
# and the dashboard off the network — remote access is meant to go through an SSH
# tunnel (docs/MAC-SETUP.md §3). Only set 0.0.0.0 on a host you have firewalled.
FT_BIND_ADDR=127.0.0.1

# ---------------------------------------------------------------------------
# Coordinator — Convex backend (self-hosted control plane)
# ---------------------------------------------------------------------------
# Admin key the convex CLI uses to deploy functions to the local backend. The
# backend mints it FROM the instance secret below, so it is not generatable here:
# overwrite it after first boot (see infra/README.md, "Deploying the Coordinator
# schema"). Treat it as a root credential — never paste it into a file that gets
# committed (diary/2026-06-25.md did exactly that).
CONVEX_SELF_HOSTED_ADMIN_KEY="convex-self-hosted|REPLACE_ME-after-first-boot"

# Instance secret the self-hosted backend signs with — 64 hex chars = 32 bytes
# exactly (an odd length crashes the backend). The admin key above DERIVES from
# it, so a guessable value hands over the whole deployment: it used to be 64
# zeros. up.sh generates it (`openssl rand -hex 32`).
CONVEX_INSTANCE_SECRET=REPLACE_ME

# URL the Rust ft-coordinator client and the convex CLI talk to.
CONVEX_URL=http://localhost:3210
CONVEX_SELF_HOSTED_URL=http://localhost:3210

# Host ports (container ports are fixed: 3210 API, 3211 site/proxy).
CONVEX_BACKEND_PORT=3210
CONVEX_SITE_PORT=3211

# ---------------------------------------------------------------------------
# Auth real — Better Auth (Fase 3, docs/adr/0014)
# ---------------------------------------------------------------------------
# Better Auth lives on the Convex HTTP-actions host. The CLI derives it from the
# Convex URL (self-hosted: port +1, i.e. 3210 -> 3211); override only for a custom
# host: CONVEX_SITE_URL=http://localhost:3211
#
# Password for `filething login` (headless). scripts/demo-gates.sh defaults it to
# a throwaway value; set it here to use your own.
# FILETHING_PASSWORD=test-password-12345   # gitleaks:allow — throwaway gate account, not a credential

# Signup (POST /api/auth/sign-up/email) is DISABLED on the Convex deployment by
# default (open, unverified signup on a public URL). scripts/demo-gates.sh sets
# this on the deployment itself (via `convex env set`, not this file) for the
# duration of the gate and reverts it afterwards — this line is documentation,
# not something the client reads.
# FILETHING_ALLOW_SIGNUP=1

# ---------------------------------------------------------------------------
# Convex dashboard (optional, web UI for the local backend)
# ---------------------------------------------------------------------------
CONVEX_DASHBOARD_PORT=6791
